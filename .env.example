# Firebase web app config — copy this file to `.env` and fill in your project's values.
# Firebase Console → Project settings → General → "Your apps" → SDK setup and configuration.
# These are safe to expose in a client bundle (Firebase security is enforced by Auth + Firestore rules),
# but we keep them in .env so each environment can point at its own project.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
