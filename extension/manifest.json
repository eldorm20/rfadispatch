{
  "manifest_version": 3,
  "name": "RFA Dispatch — Amazon Relay Sync",
  "version": "0.1.0",
  "description": "Captures Amazon Relay trips in your authenticated session and syncs them to the RFA Dispatch TMS in real time.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://relay.amazon.com/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://relay.amazon.com/*"],
      "js": ["src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://relay.amazon.com/*"],
      "js": ["src/mapping.js", "src/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "options_page": "src/options.html",
  "action": { "default_popup": "src/popup.html", "default_title": "RFA Dispatch Sync" }
}
